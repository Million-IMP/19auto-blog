ANTHROPIC_API_KEY=

# 기본값 claude-haiku-5-5
# ANTHROPIC_MODEL=claude-haiku-5-5

# --- 이미지 생성 (선택). 비워 두면 무료 pollinations를 쓴다 ---
# IMAGE_PROVIDER=ideogram
# IDEOGRAM_API_KEY=
# turbo | default | quality (뒤로 갈수록 품질과 비용이 올라감)
# IDEOGRAM_RENDERING_SPEED=turbo
# off(기본, 계획한 prompt 그대로) | auto | on
# IDEOGRAM_MAGIC_PROMPT=off
# Vercel 배포에서 Ideogram을 쓸 때 필수. 로컬은 없으면 backend/generated-images에 저장한다.
# BLOB_READ_WRITE_TOKEN=

# --- 접근 제한 (선택). 설정하면 화면·API에 비밀번호가 필요하다. 비워 두면 잠그지 않는다 ---
# APP_PASSWORD=

# --- 배포(Vercel)용 ---
# 비우면 로컬 SQLite 파일(backend/prisma/dev.db)
# DATABASE_URL=postgresql://...
# 풀링 없는 주소(Neon의 DATABASE_URL_UNPOOLED). 비우면 DATABASE_URL을 쓴다
# DIRECT_URL=postgresql://...
# Vercel 크론 호출 확인용 임의 문자열
# CRON_SECRET=
# 1이면 Vercel 빌드 때 DB 구조를 자동 반영한다(처음 배포할 때 권장)
# DB_PUSH_ON_BUILD=1
