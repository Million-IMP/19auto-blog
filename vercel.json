{
  "framework": null,
  "installCommand": "npm install && npm install --prefix frontend",
  "buildCommand": "node scripts/prepare-db.js && npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/((?!cron/).*)",
      "destination": "/api/server"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/server.ts": {
      "maxDuration": 300
    },
    "api/cron/daily.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 0 * * *"
    }
  ]
}
